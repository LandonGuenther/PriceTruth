# Postgres connection string (matches docker-compose.yml service "db").
# In production this must NOT point at localhost (config fails fast).
DATABASE_URL=postgresql://pricetruth:pricetruth@localhost:5432/pricetruth

# Runtime environment: development | test | staging | production.
NODE_ENV=development

# Bind address. Default: 127.0.0.1 in development/test, 0.0.0.0 in staging/production.
HOST=127.0.0.1

# Port for the API server.
PORT=3000

# Log level (pino). Default: debug (development), info (staging/production), silent (test).
LOG_LEVEL=

# Whether to trust X-Forwarded-For/Proto from a proxy: true | false | <hop count> | comma CIDR/IP list.
TRUST_PROXY=false

# Request/body limits.
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT_BYTES=65536

# Per-IP rate limits (requests per minute) by endpoint class.
RATE_LIMIT_INGEST_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=240
RATE_LIMIT_HEALTH_PER_MINUTE=600

# Comma-separated allowed Chrome extension ids (each 32 chars, [a-p]).
# Unset → any chrome-extension:// origin is allowed (warned in staging/production).
ALLOWED_EXTENSION_IDS=

# Comma-separated extra allowed CORS origins (e.g. an ops dashboard). Never use "*".
CORS_ORIGINS=

# Optional. ≥32 chars when set; enables /internal/* routes (status, metrics).
INTERNAL_API_TOKEN=

# Optional. Only needed to enable the Best Buy products API observation source;
# the API works without it (extension-reported observations still function).
BESTBUY_API_KEY=

# Archive backend: local | s3. When s3, all S3_* vars below are required.
ARCHIVE_BACKEND=local

# Root dir for `pnpm --filter @pricetruth/api jobs archive` (local backend).
ARCHIVE_LOCAL_DIR=./archive

# S3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_REQUEST_TIMEOUT_MS=30000

# Optional. Reported by GET /health as `version` (set to the git sha at build time).
APP_VERSION=
