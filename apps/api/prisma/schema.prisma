// PriceTruth data model (V1).
//
// Immutability rules:
// - PriceObservation rows are append-only facts. `status` is the ONLY mutable
//   column and may change only via setObservationStatus(), which appends an
//   ObservationStatusEvent; a DB trigger rejects any other UPDATE or DELETE.
// - Listing holds descriptive metadata only (no price fields, so there is no
//   mutable "currentPrice" to go stale). Its metadata fields MAY be updated to
//   the newest observed values.
// - MVP scope: a Product is created 1:1 per Listing on first observation. There
//   is no cross-retailer product merging yet; ProductIdentifier records the
//   identifiers we saw (ASIN / BESTBUY_SKU / GTIN) so merging can be added later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Retailer {
  id          String    @id // "amazon" | "bestbuy" — matches RetailerId in @pricetruth/shared
  displayName String
  createdAt   DateTime  @default(now())
  listings    Listing[]
}

enum IdentifierType {
  GTIN
  UPC
  EAN
  MPN
  ASIN
  BESTBUY_SKU
  MANUFACTURER_MODEL
}

enum AssertionStatus {
  ACTIVE
  RETRACTED
}

enum MatchLevel {
  EXACT
  HIGH
  REVIEW
  UNRESOLVED
  CONFLICT
}

enum ProductLinkAction {
  LINK
  UNLINK
}

enum SourceType {
  EXTENSION_DOM
  OFFICIAL_RETAILER_API
  MERCHANT_FEED
  LICENSED_DATA
  MANUAL_VERIFICATION
  SYNTHETIC_TEST
}

enum TrustClass {
  CLIENT_REPORTED
  SERVER_FETCHED
  VERIFIED
  TEST
}

enum RedistributionReviewStatus {
  UNKNOWN
  INTERNAL_ONLY
  AGGREGATED_ONLY
  APPROVED
}

enum PriceType {
  STANDARD
  SALE
  MEMBER
  SUBSCRIPTION
  COUPON_REQUIRED
  INSTALLMENT
  USED
  REFURBISHED
  MARKETPLACE
  UNKNOWN
}

enum ReferencePriceType {
  WAS_PRICE
  LIST_PRICE
  MSRP
  COMP_VALUE
  REGULAR_PRICE
  UNKNOWN
}

enum ObservationStatus {
  RECEIVED
  ACCEPTED
  CORROBORATED
  QUARANTINED
  EXCLUDED
}

model Product {
  id          String              @id @default(uuid()) @db.Uuid
  title       String
  brand       String?
  modelNumber String?
  familyId    String?             @db.Uuid
  family      ProductFamily?      @relation(fields: [familyId], references: [id])
  createdAt   DateTime            @default(now())
  identifiers ProductIdentifier[]
  listings    Listing[]
}

model ProductFamily {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  brand     String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model ProductIdentifier {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @db.Uuid
  product   Product        @relation(fields: [productId], references: [id])
  type      IdentifierType
  value     String

  @@unique([type, value])
}

model DataSource {
  id                         String                     @id @default(uuid()) @db.Uuid
  key                        String                     @unique // "extension:content-script" etc.
  displayName                String
  sourceType                 SourceType
  trustClass                 TrustClass
  redistributionReviewStatus RedistributionReviewStatus @default(UNKNOWN)
  termsReference             String?
  reviewedAt                 DateTime?
  notes                      String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  observations               PriceObservation[]
  assertions                 IdentifierAssertion[]
}

model Listing {
  id           String            @id @default(uuid()) @db.Uuid
  retailerId   String
  retailer     Retailer          @relation(fields: [retailerId], references: [id])
  externalId   String
  url          String
  title        String
  brand        String?
  modelNumber  String?
  gtin         String?
  productId    String?           @db.Uuid
  product      Product?          @relation(fields: [productId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  observations PriceObservation[]
  variants     ListingVariant[]
  assertions   IdentifierAssertion[]
  matchEvidence MatchEvidence[]
  linkEvents    ProductLinkEvent[]

  @@unique([retailerId, externalId])
}

model ListingVariant {
  id           String             @id @default(uuid()) @db.Uuid
  listingId    String             @db.Uuid
  listing      Listing            @relation(fields: [listingId], references: [id])
  fingerprint  String             @db.Char(64) // sha256 of canonical JSON (sorted keys) of attributes
  attributes   Json
  createdAt    DateTime           @default(now())
  observations PriceObservation[]

  @@unique([listingId, fingerprint])
}

model PriceObservation {
  id                  BigInt                    @id @default(autoincrement())
  listingId           String                    @db.Uuid
  listing             Listing                   @relation(fields: [listingId], references: [id])
  variantId           String?                   @db.Uuid
  variant             ListingVariant?           @relation(fields: [variantId], references: [id])
  dataSourceId        String                    @db.Uuid
  dataSource          DataSource                @relation(fields: [dataSourceId], references: [id])
  priceCents          Int
  priceType           PriceType                 @default(UNKNOWN)
  referencePriceCents Int?
  referenceType       ReferencePriceType?
  currency            String                    @db.Char(3)
  inStock             Boolean?
  receivedAt          DateTime                  @default(now()) // server-authoritative ingestion time
  clientObservedAt    DateTime? // as reported by the client, untrusted
  effectiveAt         DateTime // time used by history/scoring/dedup (see timePolicy)
  clientSkewSeconds   Int? // clientObservedAt - receivedAt, for skew monitoring
  status              ObservationStatus         @default(ACCEPTED)
  synthetic           Boolean                   @default(false)
  schemaVersion       Int
  clientVersion       String?
  extractorVersion    String?
  statusEvents        ObservationStatusEvent[]

  @@index([listingId, effectiveAt])
  @@index([dataSourceId])
}

model ObservationStatusEvent {
  id            BigInt            @id @default(autoincrement())
  observationId BigInt
  observation   PriceObservation  @relation(fields: [observationId], references: [id])
  fromStatus    ObservationStatus
  toStatus      ObservationStatus
  reason        String
  actor         String            @db.VarChar(120)
  createdAt     DateTime          @default(now())

  @@index([observationId])
}

/**
 * An identifier asserted about a Listing by a data source, in normalized form.
 * `normalizedValue` follows @pricetruth/catalog normalization (GTIN-family →
 * 14-digit GTIN; ASIN → uppercase; models → upper/collapsed whitespace).
 */
model IdentifierAssertion {
  id              BigInt          @id @default(autoincrement())
  listingId       String          @db.Uuid
  listing         Listing         @relation(fields: [listingId], references: [id])
  type            IdentifierType
  rawValue        String          @db.VarChar(200)
  normalizedValue String          @db.VarChar(200)
  valid           Boolean
  dataSourceId    String          @db.Uuid
  dataSource      DataSource      @relation(fields: [dataSourceId], references: [id])
  status          AssertionStatus @default(ACTIVE)
  firstSeenAt     DateTime        @default(now())
  lastSeenAt      DateTime        @default(now())

  @@unique([listingId, type, normalizedValue])
  @@index([type, normalizedValue])
}

model MatchEvidence {
  id                 BigInt     @id @default(autoincrement())
  listingId          String     @db.Uuid
  listing            Listing    @relation(fields: [listingId], references: [id])
  candidateProductId String?    @db.Uuid
  level              MatchLevel
  reasons            String[]
  engineVersion      String     @db.VarChar(32)
  evaluatedAt        DateTime   @default(now())

  @@index([listingId, evaluatedAt])
}

model ProductLinkEvent {
  id                BigInt            @id @default(autoincrement())
  listingId         String            @db.Uuid
  listing           Listing           @relation(fields: [listingId], references: [id])
  action            ProductLinkAction
  previousProductId String?           @db.Uuid
  newProductId      String?           @db.Uuid
  reason            String
  actor             String            @db.VarChar(120)
  createdAt         DateTime          @default(now())

  @@index([listingId, createdAt])
}
