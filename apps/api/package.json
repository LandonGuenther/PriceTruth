{
  "name": "@pricetruth/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "catalog": "tsx scripts/catalog.ts",
    "jobs": "tsx scripts/jobs.ts",
    "ops": "tsx scripts/ops.ts",
    "loadgen": "tsx scripts/loadgen.ts",
    "bench": "tsx scripts/bench.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1126.0",
    "@dsnp/parquetjs": "1.8.9",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@pricetruth/catalog": "workspace:*",
    "@pricetruth/scoring": "workspace:*",
    "@pricetruth/shared": "workspace:*",
    "@prisma/client": "^6.2.0",
    "@smithy/node-http-handler": "4.12.1",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
