{
  "name": "@pricetruth/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.content.config.ts && tsx scripts/write-manifest.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "tsx scripts/package.ts",
    "gen-icons": "tsx scripts/gen-icons.ts",
    "verify-package": "tsx scripts/verify-package.ts"
  },
  "dependencies": {
    "@pricetruth/retailer-adapters": "workspace:*",
    "@pricetruth/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "archiver": "^7.0.1",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
